/cloudflared/config.yml

# Scripts locais / testes (não versionar)
/tmp/
/.continue/
/scripts/supabase/migrations-prod.json
/scripts/supabase/prod-deploy/out/
/scripts/supabase/out/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Pastas Pessoais e Documentos Externos
/Documentos/
/Helena/

#File extensions
*.txt
Contas Ragnar.txt

