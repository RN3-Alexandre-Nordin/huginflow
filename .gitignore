# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# MCP local overrides (opcional; o exemplo versionado é mcp.json.example)
# .cursor/mcp.json

# Cloudflare tunnel local (credenciais)
/cloudflared/config.yml

# Scripts locais / testes (não versionar)
/tmp/
/.continue/
/scripts/supabase/migrations-prod.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Pastas Pessoais e Documentos Externos
/Documentos/
/Helena/

#File extensions
*.txt
Contas Ragnar.txt