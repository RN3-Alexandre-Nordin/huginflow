# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# MCP local overrides (opcional; o exemplo versionado é mcp.json.example)
# .cursor/mcp.json

# Cloudflare tunnel local (credenciais)
/cloudflared/config.yml

# Scripts locais / testes (não versionar)
/tmp/
/.continue/
/scripts/supabase/migrations-prod.json
/scripts/supabase/prod-deploy/out/
/scripts/supabase/out/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Pastas Pessoais e Documentos Externos
/Documentos/
/Helena/

#File extensions
*.txt
Contas HuginFlow.txt

# Relatórios gerados do agente (histórico local; metadados no Supabase)
/docs/homologacao/execucoes/agente-*.md
/docs/homologacao/execucoes/agente-*.json
/docs/homologacao/execucoes/agente-*.html
/docs/homologacao/execucoes/*/

# Capturas duplicadas por falha de script
/docs/manual/img/steps/steps/