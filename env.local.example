RAGNAR_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Evolution — VPS de DESENVOLVIMENTO (não use credenciais de produção)
WHATSAPP_API_URL_DEV=https://evo-dev.rn3.tec.br
WHATSAPP_API_TOKEN_DEV=
# Tunel fixo Cloudflare (recomendado): npm run tunnel:setup + npm run tunnel:fixed
RAGNAR_WEBHOOK_URL_DEV=https://ragnar-local.rn3.tec.br/api/webhooks/evolution

# Supabase — projeto DEV ragnar-dev (ref: vujqukqsfwmoezwyuoum)
# Não use as chaves de produção aqui. Ver docs/supabase-dev-prod.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=

# Após clone prod→dev: senhas Auth não são copiadas. Rode uma vez:
# node scripts/supabase/reset-dev-auth-password.mjs seu@email.com "SuaSenhaDev"
