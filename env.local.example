# =============================================================================
# Copie para .env.local (desenvolvimento local — NUNCA commitar)
# cp env.local.example .env.local
# =============================================================================

# Preferir HUGINFLOW_ENV (RAGNAR_ENV ainda funciona como legado)
HUGINFLOW_ENV=development
# RAGNAR_ENV=development

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Evolution — VPS de DESENVOLVIMENTO (não use credenciais de produção)
WHATSAPP_API_URL_DEV=https://evo-dev.rn3.tec.br
WHATSAPP_API_TOKEN_DEV=

# Tunel Cloudflare (infra RN3 — hostname legado ok até opcional rename)
# Preferir HUGINFLOW_WEBHOOK_URL_DEV (RAGNAR_* ainda lido pelo código)
HUGINFLOW_WEBHOOK_URL_DEV=https://ragnar-local.rn3.tec.br/api/webhooks/evolution
# RAGNAR_WEBHOOK_URL_DEV=https://ragnar-local.rn3.tec.br/api/webhooks/evolution

# Supabase — projeto DEV (labels históricos "ragnar-dev" no dashboard)
# Não use as chaves de produção aqui. Ver docs/supabase-dev-prod.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=

# Após clone prod→dev: senhas Auth não são copiadas. Rode uma vez:
# node scripts/supabase/reset-dev-auth-password.mjs seu@email.com "SuaSenhaDev"
