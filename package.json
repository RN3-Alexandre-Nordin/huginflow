{
  "name": "huginflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "dev:prod": "next build --webpack && next start",
    "tunnel": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-tunnel.ps1",
    "tunnel:fixed": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-tunnel-named.ps1",
    "tunnel:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-cloudflare-tunnel.ps1",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "manual:capture": "node scripts/manual/capture-screenshots.mjs",
    "manual:capture:omni": "node scripts/manual/capture-screenshots.mjs --omni",
    "manual:capture:chat-badge": "node scripts/manual/capture-screenshots.mjs --chat-badge",
    "manual:capture:treinamento": "node scripts/manual/capture-screenshots.mjs --treinamento",
    "manual:video": "node scripts/manual/capture-screenshots.mjs --video",
    "homologacao:prod": "node scripts/supabase/run-homologacao-prod.mjs",
    "homologacao:prod:reuse-tenant": "node scripts/supabase/run-homologacao-prod.mjs --skip-bootstrap",
    "test:e2e:core": "playwright test e2e/core",
    "test:e2e:core:ui": "playwright test e2e/core --ui",
    "test:e2e:report": "playwright show-report",
    "test:agent:dev": "node scripts/agent/run-agent-dev.mjs",
    "test:agent:scripts": "node scripts/agent/phase1-scripts.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "@tanstack/react-query": "^5.96.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.1",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "openai": "^6.45.0",
    "pdf-parse": "^1.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
