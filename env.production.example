# =============================================================================
# Template PRODUÇÃO — NÃO aplicar cutover de domínio neste arquivo até a P6.
# URLs atuais (app.ragnar.ia.br) permanecem até HostGator/Cloudflare + Traefik.
#
# Preferência de variáveis: HUGINFLOW_* (RAGNAR_* ainda suportado pelo código).
# Copie para o .env da VPS somente quando for deploy consciente.
# =============================================================================

NODE_ENV=production
HUGINFLOW_ENV=production
# RAGNAR_ENV=production

# Até o cutover (P6), mantenha o host atual em produção:
NEXT_PUBLIC_APP_URL=https://app.ragnar.ia.br
# Após cutover:
# NEXT_PUBLIC_APP_URL=https://app.huginflow.com

# Supabase — projeto PROD (VPS + secrets GitHub Actions)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Evolution API — VPS PRODUÇÃO
WHATSAPP_API_URL_PROD=https://evo.rn3.tec.br
WHATSAPP_API_TOKEN_PROD=

HUGINFLOW_WEBHOOK_URL_PROD=https://app.ragnar.ia.br/api/webhooks/evolution
# RAGNAR_WEBHOOK_URL_PROD=https://app.ragnar.ia.br/api/webhooks/evolution
# Após cutover:
# HUGINFLOW_WEBHOOK_URL_PROD=https://app.huginflow.com/api/webhooks/evolution

OPENAI_API_KEY=
NEXT_PUBLIC_LANDING_PAGE_TOKEN=
